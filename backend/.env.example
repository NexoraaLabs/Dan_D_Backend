# Copy to .env and fill in real values before running the server.

# MySQL connection string. Local install, Docker, or a managed instance
# (AWS RDS / PlanetScale / GCP Cloud SQL) all work as long as they speak MySQL 8.
DATABASE_URL="mysql://root:password@localhost:3306/dan_d_collection"

PORT=4000
NODE_ENV=development

# Symmetric secret used to sign access + refresh JWTs. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Image uploads (POST /api/uploads) are written here and served at /uploads.
# On Railway, attach a Volume and point this at its mount path (e.g. /data/uploads),
# otherwise uploaded images are lost on every redeploy.
UPLOAD_DIR=uploads
# Public origin for upload URLs, e.g. https://your-app.up.railway.app (optional).
PUBLIC_BASE_URL=

# No email provider yet: verification / reset codes are only logged. "true"
# also returns them in API responses (devCode) for testing. Turn off before launch.
EXPOSE_DEV_CODES=false

# --- Third-party integrations the proposal implies but does not specify ---
# Mobile subscriptions (Silver/Gold/Platinum) must go through Apple/Google IAP
# for App Store / Play Store compliance; a card processor alone is not enough.
# Wire the real product/receipt-validation IDs here once decided.
APPLE_IAP_SHARED_SECRET=
GOOGLE_PLAY_PACKAGE_NAME=

# Card-on-file for marketplace purchases (non-subscription) can use Stripe.
STRIPE_SECRET_KEY=

# Dealer map / geocoding.
GOOGLE_MAPS_API_KEY=

# Item photo storage (S3-compatible). Local disk is used as a fallback in dev.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Push notifications.
FCM_SERVER_KEY=
