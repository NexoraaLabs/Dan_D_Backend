{
  "openapi": "3.0.3",
  "info": {
    "title": "DAN D Collection API",
    "version": "0.1.0",
    "description": "Collector & trading platform backend. Auth is JWT bearer (access token from /auth/login or /auth/register, refreshed via /auth/refresh). All endpoints below are prefixed with the `/api` server base except /health."
  },
  "servers": [
    { "url": "http://localhost:4000", "description": "Local dev" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" }, "details": {} }
      },
      "AuthSession": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" }
        }
      },
      "Plan": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "code": { "type": "string", "enum": ["FREE", "SILVER", "GOLD", "PLATINUM"] },
          "name": { "type": "string" },
          "priceCents": { "type": "integer" },
          "billingPeriod": { "type": "string" },
          "itemLimit": { "type": "integer", "nullable": true }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "email": { "type": "string", "format": "email" },
          "username": { "type": "string" },
          "fullName": { "type": "string", "nullable": true },
          "avatarUrl": { "type": "string", "nullable": true },
          "bio": { "type": "string", "nullable": true },
          "phone": { "type": "string", "nullable": true },
          "lat": { "type": "number", "nullable": true },
          "lng": { "type": "number", "nullable": true },
          "address": { "type": "string", "nullable": true },
          "planId": { "type": "integer", "nullable": true },
          "plan": { "$ref": "#/components/schemas/Plan" },
          "trialEndsAt": { "type": "string", "format": "date-time", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "PublicUser": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "username": { "type": "string" },
          "fullName": { "type": "string", "nullable": true },
          "avatarUrl": { "type": "string", "nullable": true },
          "bio": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "icon": { "type": "string", "nullable": true },
          "parentId": { "type": "integer", "nullable": true },
          "children": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } }
        }
      },
      "Collection": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "ownerId": { "type": "integer" },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "coverImageUrl": { "type": "string", "nullable": true },
          "eventDate": { "type": "string", "format": "date-time", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "ItemImage": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "url": { "type": "string" },
          "position": { "type": "integer" }
        }
      },
      "Item": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "ownerId": { "type": "integer" },
          "collectionId": { "type": "integer", "nullable": true },
          "categoryId": { "type": "integer", "nullable": true },
          "title": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["HAVE", "WANT", "FOR_TRADE", "SHOWCASE"] },
          "condition": { "type": "string", "nullable": true },
          "brand": { "type": "string", "nullable": true },
          "year": { "type": "integer", "nullable": true },
          "estimatedValueCents": { "type": "integer", "nullable": true },
          "images": { "type": "array", "items": { "$ref": "#/components/schemas/ItemImage" } },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Wishlist": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "userId": { "type": "integer" },
          "categoryId": { "type": "integer", "nullable": true },
          "query": { "type": "string" },
          "matchedItemId": { "type": "integer", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "MarketplaceListing": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "itemId": { "type": "integer" },
          "item": { "$ref": "#/components/schemas/Item" },
          "sellerId": { "type": "integer" },
          "listingType": { "type": "string", "enum": ["SALE", "TRADE", "AUCTION"] },
          "priceCents": { "type": "integer", "nullable": true },
          "status": { "type": "string", "enum": ["ACTIVE", "SOLD", "CANCELLED", "EXPIRED"] },
          "auction": { "$ref": "#/components/schemas/Auction" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Auction": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "listingId": { "type": "integer" },
          "startPriceCents": { "type": "integer" },
          "currentPriceCents": { "type": "integer" },
          "bidIncrementCents": { "type": "integer" },
          "startsAt": { "type": "string", "format": "date-time" },
          "endsAt": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "enum": ["SCHEDULED", "LIVE", "ENDED"] },
          "winnerId": { "type": "integer", "nullable": true },
          "bids": { "type": "array", "items": { "$ref": "#/components/schemas/Bid" } }
        }
      },
      "Bid": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "auctionId": { "type": "integer" },
          "bidderId": { "type": "integer" },
          "amountCents": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "TradeOfferItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "itemId": { "type": "integer" },
          "item": { "$ref": "#/components/schemas/Item" },
          "side": { "type": "string", "enum": ["GIVE", "GET"] },
          "ownerId": { "type": "integer" }
        }
      },
      "TradeRequest": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "initiatorId": { "type": "integer" },
          "recipientId": { "type": "integer" },
          "status": { "type": "string", "enum": ["PENDING", "ACCEPTED", "REJECTED", "CANCELLED", "COMPLETED"] },
          "message": { "type": "string", "nullable": true },
          "offerItems": { "type": "array", "items": { "$ref": "#/components/schemas/TradeOfferItem" } },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "ShippingAddress": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "userId": { "type": "integer" },
          "fullName": { "type": "string" },
          "line1": { "type": "string" },
          "line2": { "type": "string", "nullable": true },
          "city": { "type": "string" },
          "state": { "type": "string" },
          "zip": { "type": "string" },
          "country": { "type": "string" },
          "phone": { "type": "string", "nullable": true },
          "isDefault": { "type": "boolean" }
        }
      },
      "PaymentMethod": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "userId": { "type": "integer" },
          "brand": { "type": "string" },
          "last4": { "type": "string" },
          "expMonth": { "type": "integer" },
          "expYear": { "type": "integer" },
          "isDefault": { "type": "boolean" }
        }
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "itemId": { "type": "integer" },
          "item": { "$ref": "#/components/schemas/Item" },
          "priceCents": { "type": "integer" }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "listingId": { "type": "integer" },
          "buyerId": { "type": "integer" },
          "sellerId": { "type": "integer" },
          "status": { "type": "string", "enum": ["PENDING", "PAID", "SHIPPED", "DELIVERED", "CANCELLED"] },
          "totalCents": { "type": "integer" },
          "trackingNumber": { "type": "string", "nullable": true },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/OrderItem" } },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "OrderRequest": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "listingId": { "type": "integer" },
          "buyerId": { "type": "integer" },
          "sellerId": { "type": "integer" },
          "offerAmountCents": { "type": "integer" },
          "status": { "type": "string", "enum": ["PENDING", "ACCEPTED", "REJECTED"] },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Conversation": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "participants": { "type": "array", "items": { "type": "object", "properties": { "userId": { "type": "integer" }, "user": { "$ref": "#/components/schemas/PublicUser" } } } },
          "messages": { "type": "array", "items": { "$ref": "#/components/schemas/Message" } }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "conversationId": { "type": "integer" },
          "senderId": { "type": "integer" },
          "body": { "type": "string", "nullable": true },
          "attachmentUrl": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "userId": { "type": "integer" },
          "type": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string", "nullable": true },
          "data": { "type": "object", "nullable": true },
          "readAt": { "type": "string", "format": "date-time", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Dealer": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "address": { "type": "string" },
          "lat": { "type": "number" },
          "lng": { "type": "number" },
          "phone": { "type": "string", "nullable": true },
          "website": { "type": "string", "nullable": true },
          "distanceKm": { "type": "number" }
        }
      }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness check",
        "security": [],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Create account (Screens: Create Account -> Verify Your Email -> Enter The Code -> Congratulations)",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["email", "password", "username"], "properties": {
            "email": { "type": "string", "format": "email" },
            "password": { "type": "string", "minLength": 8 },
            "username": { "type": "string" },
            "fullName": { "type": "string" }
          } } } }
        },
        "responses": {
          "201": { "description": "Session issued", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthSession" } } } },
          "409": { "description": "Email or username already in use", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log in (Screen: Login)",
        "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["email", "password"], "properties": { "email": { "type": "string" }, "password": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Session issued", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthSession" } } } }, "401": { "description": "Invalid credentials" } }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Exchange a refresh token for a new session",
        "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["refreshToken"], "properties": { "refreshToken": { "type": "string" } } } } } },
        "responses": { "200": { "description": "New session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthSession" } } } } }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Revoke a refresh token",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["refreshToken"], "properties": { "refreshToken": { "type": "string" } } } } } },
        "responses": { "204": { "description": "Logged out" } }
      }
    },
    "/api/users/me": {
      "get": { "tags": ["Users"], "summary": "Current user profile (Screen: My Profile)", "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } } } },
      "patch": {
        "tags": ["Users"],
        "summary": "Update profile (Screen: Edit Profile)",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": {
          "fullName": { "type": "string" }, "avatarUrl": { "type": "string" }, "bio": { "type": "string" }, "phone": { "type": "string" },
          "lat": { "type": "number" }, "lng": { "type": "number" }, "address": { "type": "string" }
        } } } } },
        "responses": { "200": { "description": "Updated user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } } }
      }
    },
    "/api/users/{id}": {
      "get": {
        "tags": ["Users"],
        "summary": "Public profile (Screens: Seller Profile - Tom, User Profile - Tom)",
        "security": [],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublicUser" } } } }, "404": { "description": "Not found" } }
      }
    },
    "/api/users/me/change-password": {
      "post": {
        "tags": ["Users"],
        "summary": "Change password (Screens: Change Password -> Thank You - Password)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["currentPassword", "newPassword"], "properties": { "currentPassword": { "type": "string" }, "newPassword": { "type": "string", "minLength": 8 } } } } } },
        "responses": { "204": { "description": "Password changed" }, "401": { "description": "Current password incorrect" } }
      }
    },
    "/api/plans": {
      "get": { "tags": ["Plans"], "summary": "List subscription tiers (Screen: Choose Your Plan)", "security": [], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Plan" } } } } } } }
    },
    "/api/categories": {
      "get": { "tags": ["Categories"], "summary": "List top-level categories with children (Screen: What Do You Collect)", "security": [], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } } } } } } }
    },
    "/api/categories/me/interests": {
      "put": {
        "tags": ["Categories"],
        "summary": "Set the current user's collecting interests (Screens: What Do You Collect, What Do You Collect - Edit)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["categoryIds"], "properties": { "categoryIds": { "type": "array", "items": { "type": "integer" } } } } } } },
        "responses": { "204": { "description": "Saved" } }
      }
    },
    "/api/collections": {
      "get": { "tags": ["Collections"], "summary": "List my collections (Screens: Collections - Events)", "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Collection" } } } } } } },
      "post": {
        "tags": ["Collections"],
        "summary": "Create a collection",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "description": { "type": "string" }, "coverImageUrl": { "type": "string" }, "eventDate": { "type": "string", "format": "date-time" } } } } } },
        "responses": { "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Collection" } } } } }
      }
    },
    "/api/collections/{id}": {
      "get": {
        "tags": ["Collections"],
        "summary": "Collection detail with items (Screen: Collections - Event Detail)",
        "security": [],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Collection" } } } }, "404": { "description": "Not found" } }
      },
      "patch": {
        "tags": ["Collections"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "200": { "description": "Updated" }, "403": { "description": "Not the owner" } }
      },
      "delete": {
        "tags": ["Collections"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "204": { "description": "Deleted" }, "403": { "description": "Not the owner" } }
      }
    },
    "/api/items": {
      "get": {
        "tags": ["Items"],
        "summary": "Browse items (Screens: Home, My Profile - Listings, My Profile - Wishlist)",
        "security": [],
        "parameters": [
          { "name": "ownerId", "in": "query", "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["HAVE", "WANT", "FOR_TRADE", "SHOWCASE"] } },
          { "name": "categoryId", "in": "query", "schema": { "type": "integer" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Item" } }, "total": { "type": "integer" }, "page": { "type": "integer" }, "pageSize": { "type": "integer" } } } } } } }
      },
      "post": {
        "tags": ["Items"],
        "summary": "Add an item (Screens: Add Item - Camera Scan -> Item Details Form -> Add to Collection). Enforces the plan's upload limit.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["title"], "properties": {
            "title": { "type": "string" }, "description": { "type": "string" },
            "status": { "type": "string", "enum": ["HAVE", "WANT", "FOR_TRADE", "SHOWCASE"], "default": "HAVE" },
            "categoryId": { "type": "integer" }, "collectionId": { "type": "integer" },
            "condition": { "type": "string" }, "brand": { "type": "string" }, "year": { "type": "integer" },
            "estimatedValueCents": { "type": "integer" }, "imageUrls": { "type": "array", "items": { "type": "string" } }
          } } } }
        },
        "responses": { "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Item" } } } }, "403": { "description": "Upload limit reached for current plan" } }
      }
    },
    "/api/items/{id}": {
      "get": {
        "tags": ["Items"],
        "summary": "Item detail (Screens: Item Detail - *)",
        "security": [],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Item" } } } }, "404": { "description": "Not found" } }
      },
      "patch": {
        "tags": ["Items"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "200": { "description": "Updated" }, "403": { "description": "Not the owner" } }
      },
      "delete": {
        "tags": ["Items"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "204": { "description": "Deleted" }, "403": { "description": "Not the owner" } }
      }
    },
    "/api/wishlist": {
      "get": { "tags": ["Wishlist"], "summary": "My wishlist (Screen: Wishlist)", "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Wishlist" } } } } } } },
      "post": {
        "tags": ["Wishlist"],
        "summary": "Add a wishlist entry (Screen: Wishlist - Item Added)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["query"], "properties": { "query": { "type": "string" }, "categoryId": { "type": "integer" } } } } } },
        "responses": { "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Wishlist" } } } } }
      }
    },
    "/api/wishlist/{id}": {
      "delete": { "tags": ["Wishlist"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "204": { "description": "Deleted" } } }
    },
    "/api/wishlist/{id}/matches": {
      "get": {
        "tags": ["Wishlist"],
        "summary": "Smart Discovery: candidate matches for a wishlist entry",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
